    {
      "kind": "para",
      "index": 56,
      "inlines": [
        {
          "text": "Tratamento a ser dispensado ao usuário no atendimento",
          "bold": true
        }
      ],
      "style": "Normal",
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 57,
      "inlines": [
        {
          "text": "O usuário deverá receber, conforme os princípios expressos na Lei nº 13.460/2017, um atendimento pautado nas seguintes diretrizes:"
        }
      ],
      "style": "Normal",
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 58,
      "inlines": [
        {
          "text": "Urbanidade;"
        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 59,
      "inlines": [
        {
          "text": "Respeito;"
        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 60,
      "inlines": [
        {
          "text": "Acessibilidade;"
        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 61,
      "inlines": [
