      "index": 54,
      "inlines": [
        {
          "text": "Instrução Normativa SRF nº 46/1997",
          "href": "http://normas.receita.fazenda.gov.br/sijut2consulta/link.action?visao=anotado&idAto=49308"
        }
      ],
      "style": "Normal",
