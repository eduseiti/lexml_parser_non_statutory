        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 62,
      "inlines": [
        {
          "text": "Presunção da boa-fé do usuário;"
        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 63,
      "inlines": [
        {
          "text": "Igualdade;"
        }
      ],
      "style": "Normal",
      "num_id": "8",
      "ilvl": 0,
      "indent_effective": 0
    },
    {
      "kind": "para",
      "index": 64,
      "inlines": [
